<?xml version="1.0" encoding="UTF-8"?>

<robot name="lego_ev3">

    <material name="grey">
        <color rgba="0.7 0.7 0.7 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="white"/>
        </visual>
    </link>

    <link name="base_gyro"/>

    <link name="ultrasonic">
        <visual>
            <geometry>
                <box size="0.03 0.07 0.03"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="left_color_light_sensor">
        <visual>
            <geometry>
                <box size="0.04 0.04 0.08"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="right_color_light_sensor">
        <visual>
            <geometry>
                <box size="0.04 0.04 0.08"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="-1.57 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="-1.57 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.1"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_gyro"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <joint name="base_gyro_joint" type="continuous">
        <parent link="base_gyro"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="base_ultrasonic_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic"/>
        <origin xyz="-0.3 0 0.15" rpy="0 0 3.14"/>
    </joint>

    <joint name="base_left_color_light_sensor_joint" type="fixed">
        <parent link="base_link"/>
        <child link="left_color_light_sensor"/>
        <origin xyz="-0.28 0.18 0.01" rpy="0 0 3.14"/> <!--z = caster wheel radius - (color light sensor z size)/2-->
    </joint>

    <joint name="base_right_color_light_sensor_joint" type="fixed">
        <parent link="base_link"/>
        <child link="right_color_light_sensor"/>
        <origin xyz="-0.28 -0.18 0.01" rpy="0 0 3.14"/> <!--z = caster wheel radius - (color light sensor z size)/2-->
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0.15 -0.2 0" rpy="0 0 0"/>
        <axis xyz="0.0 1 0.0"/>
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0.15 0.2 0" rpy="0 0 0"/>
        <axis xyz="0.0 1 0.0"/>
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="-0.15 0 0" rpy="0 0 0"/>
    </joint>

</robot>